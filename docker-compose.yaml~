# syntax=docker/dockerfile:1.7
FROM ghcr.io/mscrnt/ubuntu-desktop:latest
# or :slim if you prefer the smaller base

# 1. Package lists + emacs (and anything else you want)
RUN apt-get update && \
    apt-get install -y --no-install-recommends emacs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 2. Caps Lock → Control (the method that worked for you)
RUN printf '\n# Caps Lock as Control\n( sleep 3 && setxkbmap -option ctrl:nocaps ) &\n' \
    >> /etc/xrdp/startwm.sh && \
    printf '\n# Caps Lock as Control\n( sleep 3 && setxkbmap -option ctrl:nocaps ) &\n' \
    >> /etc/xrdp/reconnectwm.sh

# 3. Stop the image from creating passwordless sudo
#    container-setup always writes /etc/sudoers.d/90-$USERNAME
#    We remove those three lines so sudo prompts for the password instead.
RUN sed -i \
    -e '/SUDOERS_FILE=/d' \
    -e '/NOPASSWD:ALL/d' \
    -e '/chmod 0440.*SUDOERS_FILE/d' \
    -e '/visudo -cf.*SUDOERS_FILE/d' \
    /usr/local/bin/container-setup

# The user is still created and added to the sudo group by container-setup,
# and still gets the password from the PASSWORD env var, so sudo works
# but now asks for the password.